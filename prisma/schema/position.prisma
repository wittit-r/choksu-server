// ประเภทพนักงาน
enum EmployeeType {
    WORKER    // คนงาน
    DRIVER    // คนขับรถ
}

// ประเภทการทำงาน
enum ShiftType {
    REGULAR   // เวลาปกติ (8.00-17.00)
    SHIFT     // กะ (3 กะ)
}

// ตำแหน่ง (คนงานธรรมดา, คนงานฝีมือ, คนงานชำนาญพิเศษ)
model Position {
    id              Int             @id @default(autoincrement())
    name            String          @map("name")
    code            String          @unique @map("code")
    employeeType    EmployeeType    @map("employee_type")

    isActive        Boolean         @default(true) @map("is_active")
    createdAt       DateTime        @default(now()) @map("created_at")
    updatedAt       DateTime?       @updatedAt @map("updated_at")

    // relations
    employees       Employee[]
    wageRates       WageRate[]
    billRates       BillRate[]

    @@index([employeeType])
    @@index([isActive])
    @@map("positions")
}
