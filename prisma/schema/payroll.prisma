// สถานะรอบจ่าย
enum PayPeriodStatus {
    OPEN      // เปิดรับข้อมูล
    CLOSED    // ปิดรับข้อมูล (ล็อคโดยบัญชี)
}

// สถานะการจ่ายเงิน
enum PayrollStatus {
    PENDING      // รอข้อมูล/รอดำเนินการ
    CALCULATED   // คำนวณแล้ว (พร้อมจ่าย)
    PAID         // จ่ายแล้ว
    CANCELLED    // ยกเลิก
}

// รอบจ่ายเงิน (Worker: 24 รอบ/ปี, Driver: 12 รอบ/ปี)
model PayPeriod {
    id                      Int                 @id @default(autoincrement())
    periodNo                Int                 @map("period_no")      // 1-24 (worker) หรือ 1-12 (driver)
    year                    Int                 @map("year")
    employeeType            EmployeeType        @map("employee_type")
    startDate               DateTime            @map("start_date")
    endDate                 DateTime            @map("end_date")
    status                  PayPeriodStatus     @default(OPEN) @map("status")

    createdAt               DateTime            @default(now()) @map("created_at")
    updatedAt               DateTime?           @updatedAt @map("updated_at")

    // relations
    payrolls                Payroll[]

    @@unique([year, periodNo, employeeType])  // ปี + รอบ + ประเภท = unique
    @@index([year])
    @@index([employeeType])
    @@index([status])
    @@map("pay_periods")
}

// การจ่ายเงิน (รายคนต่อรอบ)
model Payroll {
    id                          Int                 @id @default(autoincrement())
    payRef                      String              @unique @map("pay_ref")    // เลขที่อ้างอิง
    employeeId                  Int                 @map("employee_id")
    payPeriodId                 Int                 @map("pay_period_id")

    // การหัก
    ssoAmount                   Decimal             @default(0) @map("sso_amount") @db.Decimal(12, 2)
    slfAmount                   Decimal             @default(0) @map("slf_amount") @db.Decimal(12, 2)
    otherDeduction              Decimal             @default(0) @map("other_deduction") @db.Decimal(12, 2)

    // สถานะ
    status                      PayrollStatus       @default(PENDING) @map("status")

    // วันที่จ่ายจริง (อาจต่างจาก payPeriod.paidDate)
    paidDate                    DateTime?           @map("paid_date")

    createdAt                   DateTime            @default(now()) @map("created_at")
    updatedAt                   DateTime?           @updatedAt @map("updated_at")

    // relations
    employee                    Employee            @relation(fields: [employeeId], references: [id])
    payPeriod                   PayPeriod           @relation(fields: [payPeriodId], references: [id])
    payrollRelates              PayrollRelate[]

    @@index([employeeId])
    @@index([payPeriodId])
    @@index([status])
    @@index([paidDate])
    @@map("payrolls")
}

// ความสัมพันธ์ Payroll-TimeEntry (ติดตามว่า time_entry ไหนถูกจ่ายในรอบไหน)
model PayrollRelate {
    id              Int             @id @default(autoincrement())
    payrollId       Int             @map("payroll_id")
    timeEntryId     Int             @map("time_entry_id")

    createdAt       DateTime        @default(now()) @map("created_at")

    // relations
    payroll         Payroll         @relation(fields: [payrollId], references: [id], onDelete: Cascade)
    timeEntry       TimeEntry       @relation(fields: [timeEntryId], references: [id])

    @@unique([payrollId, timeEntryId])  // ป้องกันซ้ำ
    @@index([payrollId])
    @@index([timeEntryId])
    @@map("payroll_relates")
}
